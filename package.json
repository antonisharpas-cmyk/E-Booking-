{
  "name": "apex-pilates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:plain": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node -e \"require('fs').rmSync('dev.db',{force:true});require('fs').rmSync('dev.db-wal',{force:true});require('fs').rmSync('dev.db-shm',{force:true})\" && npm run db:push && npm run db:seed",
    "setup": "node scripts/init-env.mjs && drizzle-kit push --force && npm run db:seed",
    "test:flows": "tsx scripts/test-flows.ts",
    "test:http": "node scripts/test-http.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "diagnose:db": "node scripts/diagnose-db.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "test:profile": "node scripts/test-profile.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:desk": "node scripts/test-desk.mjs",
    "doctor": "node scripts/doctor.mjs",
    "staff": "node scripts/staff.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.40.1",
    "jose": "5.9.6",
    "next": "15.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "17.7.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.30.5",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
