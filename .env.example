# ---------- Database ----------
# Local development (SQLite, zero setup)
DATABASE_URL="file:./dev.db"

# ---------- Auth ----------
# Any long random string. Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- App ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Stripe ----------
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---------- Testing without Stripe ----------
# When no real Stripe key is set, "Buy pack" grants the credits immediately so
# you can click through booking end to end. This happens automatically in
# development. Set this to true to allow it in a production build too (useful
# for a staging demo) — leave it out on the live site.
# ALLOW_TEST_PAYMENTS="true"
